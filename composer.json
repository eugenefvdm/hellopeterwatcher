{
    "name": "eugenefvdm/hellopeterwatcher",
    "description": "Hello Peter Watcher",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Eugenevdm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.4",
        "vlucas/phpdotenv": "^5.5",
        "guzzlehttp/guzzle": "^7.9"
    },
    "license": "MIT",
    "require-dev": {
        "pestphp/pest": "*"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
