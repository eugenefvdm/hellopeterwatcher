HELLO_PETER_API_KEY=your_api_key_here 

BULKSMS_USERNAME=your_username_here
BULKSMS_PASSWORD=your_password_here
BULKSMS_RECIPIENTS=27000000000,27000000001
# 7bit = GSM, no emoji; 16bit = Unicode, emoji, max 70 chars
BULKSMS_ENCODING=7bit

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T0611111111/B0611111111/1234567890

ENABLE_BULKSMS=false
ENABLE_SLACK=false
ENABLE_TELEGRAM=false

# Set to true to run the "sends a real SMS" test (needs valid BULKSMS_* and BULKSMS_RECIPIENTS)
ENABLE_SMS_TEST=false
